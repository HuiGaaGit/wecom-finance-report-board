[Unit]
Description=Apply retention policy to project 17 offsite backups

[Service]
Type=oneshot
User=root
Group=root
Environment=BACKUP_ROOT=/var/backups/wecom-finance-report-board
Environment=RETENTION_DAYS=90
ExecStart=/usr/local/sbin/wecom-finance-offsite-retention
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/wecom-finance-report-board
