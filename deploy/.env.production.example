NODE_ENV=production
AUTH_MODE=platform
PORT=3180
HOST=127.0.0.1
APP_BASE_PATH=/platform/finance
PUBLIC_BASE_URL=https://anqiaoyiminxq.com/platform/finance
FINANCE_ALLOWED_ORIGIN=https://anqiaoyiminxq.com
PORTAL_HOME_URL=/platform/
SESSION_SECRET=CHANGE_ME_USE_AT_LEAST_64_RANDOM_CHARACTERS_0123456789abcdef
PLATFORM_API_BASE_URL=https://anqiaoyiminxq.com/api
PLATFORM_LOGIN_URL=/platform/login
DB_FILE=/var/lib/wecom-finance/report-board.db
UPLOADS_DIR=/var/lib/wecom-finance/uploads
CONSULTANT_DIRECTORY_FILE=/var/lib/wecom-finance/consultant-directory.json
CONSULTANT_DIRECTORY_STATUS_FILE=/var/lib/wecom-finance/consultant-directory-status.json
CONSULTANT_DIRECTORY_REFRESH_REQUEST_FILE=/var/lib/wecom-finance/consultant-directory-refresh-request.json
CONSULTANT_DIRECTORY_AUTH_REQUEST_FILE=/var/lib/wecom-finance/consultant-directory-auth-request.json
CONSULTANT_DIRECTORY_INPUT_FILE=/var/lib/wecom-finance/consultant-directory-input.json
UPLOAD_MAPPING_LLM_ENABLED=false
UPLOAD_MAPPING_LLM_API_URL=https://open.bigmodel.cn/api/paas/v4
UPLOAD_MAPPING_LLM_MODEL=glm-5-turbo
UPLOAD_MAPPING_LLM_API_KEY=CHANGE_ME_PROJECT_SCOPED_SECRET
UPLOAD_MAPPING_LLM_TIMEOUT_MS=8000
